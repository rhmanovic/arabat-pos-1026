{
  "name": "arabat-pos",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "pnpm --filter \"./apps/*\" --parallel run dev",
    "build": "pnpm -r run build",
    "start": "pnpm --filter @arabat/api run start",
    "typecheck": "pnpm build:packages && pnpm -r run typecheck",
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project web",
    "test:watch": "vitest --project unit --project web",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @arabat/api run db:generate",
    "db:migrate": "pnpm --filter @arabat/api run db:migrate",
    "db:seed": "pnpm --filter @arabat/api run db:seed",
    "setup:local": "node scripts/setup.mjs",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@swc/core": "^1.16.18",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.4",
    "@vitejs/plugin-react": "^6.1.2"
  }
}
