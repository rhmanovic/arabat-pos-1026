# Google Cloud production settings (ADR-0105, OPERATIONS.md §9). Copy to infra/gcp/config.env
# (git-ignored) and fill in. No secrets here: passwords and keys are generated by
# provision.sh straight into Secret Manager.

PROJECT_ID=arabat-511416               # Google Cloud project (billing enabled)
REGION=me-central1                     # Doha: Cloud Run, Cloud SQL, Storage in one region
DOMAIN=www.arabatapp.com               # primary address (owner, 2026-10-15). Cloudflare DNS: A record → load balancer IP, DNS only (grey cloud)
REDIRECT_DOMAINS="arabatapp.com app.arabatpos.com"  # answered with a 301 to https://DOMAIN (same DNS record each)
MAIL_DOMAIN=send.arabatapp.com        # sender: no-reply@MAIL_DOMAIN (the domain verified at Resend)
ALERT_EMAIL=owner@example.com          # receives uptime and backup-failure alerts

SQL_INSTANCE=arabat-prod-db
SQL_TIER=db-custom-1-3840              # 1 dedicated vCPU, 3.75 GB; HA off (ADR-0105)
SQL_STORAGE_GB=20
DB_NAME=arabat

SERVICE=arabat-web                     # Cloud Run service (API + the four web apps)
MIGRATE_JOB=arabat-migrate             # Cloud Run job run before every release
AR_REPO=arabat                         # Artifact Registry repository for images

UPLOADS_BUCKET=arabat-prod-uploads     # product images (private)
# Daily / monthly exports of the database, in a second region (owner, 2026-10-15: "the most
# suitable, perhaps the UAE"). Google has no UAE region; Dammam needs invoiced billing, so the
# copy goes to Frankfurt (ADR-0105).
BACKUP_BUCKET=arabat-prod-db-exports
BACKUP_BUCKET_LOCATION=europe-west3
BACKUP_VAULT_RETENTION_DAYS=90         # enhanced backups: nobody can delete them earlier

# Client IP behind the load balancer: X-Forwarded-For is "<client>, <load balancer>".
# Confirm after the first deploy (OPERATIONS.md §9.4) before relying on rate limits by IP.
TRUST_PROXY=2
