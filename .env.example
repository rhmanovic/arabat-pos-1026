# Copy to .env for local development: cp .env.example .env
# Values below are for LOCAL DEVELOPMENT ONLY. Never commit real secrets.

# NODE_ENV is intentionally not set here: the API defaults to "development" and
# Vite must not inherit it (it would bundle React's development build).
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
LOG_PRETTY=true

# Docker Compose PostgreSQL (docker-compose.yml)
POSTGRES_PORT=5432
POSTGRES_SUPERUSER_PASSWORD=postgres_dev_only
APP_OWNER_PASSWORD=app_owner_dev_only
APP_RUNTIME_PASSWORD=app_runtime_dev_only

# API runtime connection: role app_runtime (subject to Row-Level Security)
DATABASE_URL=postgres://app_runtime:app_runtime_dev_only@localhost:5432/arabat_dev
# Schema owner connection: used only by `pnpm db:migrate` and `pnpm db:seed`
DATABASE_OWNER_URL=postgres://app_owner:app_owner_dev_only@localhost:5432/arabat_dev
DATABASE_POOL_MAX=10

# Integration tests (separate database, same roles)
TEST_DATABASE_URL=postgres://app_runtime:app_runtime_dev_only@localhost:5432/arabat_test
TEST_DATABASE_OWNER_URL=postgres://app_owner:app_owner_dev_only@localhost:5432/arabat_test

# Platform operators' TOTP secrets are encrypted with this key (32 bytes, base64).
# DEVELOPMENT VALUE ONLY — generate a new one for every other environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=VFZOJrTc/gBvE/+ElghyAt/0JVSBdrV8+m1D1ZOdSp4=

# Session cookies: Secure flag (defaults to true when NODE_ENV=production)
COOKIE_SECURE=false

# E-mail: Mailpit from docker-compose (web UI http://localhost:8025)
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Arabat POS <no-reply@arabat.local>
# Hosted environments that block outbound SMTP (Railway below Pro): a provider's HTTP API
# MAIL_PROVIDER=resend   # or brevo
# MAIL_API_KEY=
# Links in e-mails (password reset) point to these app URLs
PUBLIC_MANAGER_URL=http://localhost:5173/manager
PUBLIC_POS_URL=http://localhost:5174/pos
PUBLIC_STORE_URL=http://localhost:5176/store
# Behind a load balancer: its hop count (e.g. 1) or addresses/CIDRs. Never "true".
TRUST_PROXY=false
# Mock payment gateway (test payments only). Off by default in production.
# PAYMENT_MOCK_ENABLED=true
# PAYMENT_MOCK_SECRET=change-me-at-least-16-chars

# POS assistant (ADR-0107): off without a key; paid usage, owner's approval required.
# ANTHROPIC_API_KEY=sk-ant-...
# ASSISTANT_MODEL=claude-opus-5-5

# Serve the built SPAs from the API (production-like single origin: `pnpm build && pnpm start`)
SERVE_WEB=false

# Vite dev servers proxy /api to this URL
VITE_API_PROXY_TARGET=http://localhost:3000
